# Required: Minimum 24 characters random secret token for admin API routes
ADMIN_TOKEN=your-32-character-random-admin-secret-key-placeholder

# Comma-separated allowed frontend origins (no wildcards)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# SQLite database URL (default inside container is /app/data/weather_platform.db)
DATABASE_URL=sqlite:////app/data/weather_platform.db
